# Optional in development. Docker Compose provides defaults for these values.
DB_PASSWORD=
SPRING_PROFILES_ACTIVE=
APP_BASE_URL=
CORS_ALLOWED_ORIGINS=

# Required to use Microsoft OAuth login.
MICROSOFT_CLIENT_ID=
