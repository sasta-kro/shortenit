# Optional in development. Docker Compose provides defaults for these values.
DB_PASSWORD=
SPRING_PROFILES_ACTIVE=
APP_BASE_URL=
APP_BASE_PATH=
CORS_ALLOWED_ORIGINS=

# Optional production image overrides (include the tag).
FRONTEND_IMAGE=
BACKEND_IMAGE=

# Optional production host ports for the local reverse proxy.
FRONTEND_HOST_PORT=
BACKEND_HOST_PORT=

# Required to use Microsoft OAuth login.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional protected administrator account.
PROTECTED_ADMIN_EMAIL=

# Required for JWT signing in Docker Compose. Must be at least 32 characters.
# Generate with: openssl rand -base64 32
JWT_SECRET=
