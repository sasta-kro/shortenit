# Add these locations inside an existing HTTPS server block.
# This example assumes APP_BASE_PATH=/shortenit and the default production
# host ports. Update the proxy destinations if those ports are overridden.

location = /shortenit {
  return 308 /shortenit/;
}

# Preserve the complete URI when proxying to Spring Boot. The proxy_pass
# directives intentionally have no trailing URI slash.
location ^~ /shortenit/api/ {
  proxy_pass http://127.0.0.1:8080;
  include proxy_params;
}

location ^~ /shortenit/oauth2/ {
  proxy_pass http://127.0.0.1:8080;
  include proxy_params;
}

location ^~ /shortenit/login/ {
  proxy_pass http://127.0.0.1:8080;
  include proxy_params;
}

location ^~ /shortenit/s/ {
  proxy_pass http://127.0.0.1:8080;
  include proxy_params;
  proxy_buffering off;
  proxy_redirect off;
}

# Next.js receives the base path unchanged, including /shortenit/_next assets.
location ^~ /shortenit/ {
  proxy_pass http://127.0.0.1:3000;
  include proxy_params;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_buffering off;
  proxy_redirect off;
}
